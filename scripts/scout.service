[Unit]
Description=Scout MCP server — terminal-native work acquisition agent
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
Environment=SCOUT_ADDR=127.0.0.1:3210
Environment=SCOUT_DATA_DIR=%h/.local/share/scout
ExecStart=%h/.local/bin/scout mcp serve
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=default.target
